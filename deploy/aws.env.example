# Copy with deploy/init-aws-env.sh. APP_DOMAIN is a hostname without https://.
APP_DOMAIN=YOUR_PUBLIC_HOSTNAME
POSTGRES_PASSWORD=GENERATED_BY_SETUP_SCRIPT
DJANGO_SECRET_KEY=GENERATED_BY_SETUP_SCRIPT
# For sample images only. Use durable object storage for real restaurant assets.
ASSET_BASE_URL=
# Optional staff menu description polishing; keep the key in deploy/aws.env on EC2.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
